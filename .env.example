# Corporate API Configuration
CORP_API_BASE_URL=https://api.corp.internal
CORP_API_KEY=your_api_key_here
CORP_API_TIMEOUT=30

# Service-specific endpoints (optional, if different from base)
# CALENDAR_API_URL=
# MAIL_API_URL=
# DIRECTORY_API_URL=

# Authentication
# AUTH_TYPE=oauth2  # or api_key, basic, etc.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_TOKEN_URL=

# Rate limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_SPAM_FILTER=true
ENABLE_RATE_LIMITING=true

# Transport Configuration
TRANSPORT=ws  # 'stdio' or 'ws'
WS_HOST=0.0.0.0
WS_PORT=8765
